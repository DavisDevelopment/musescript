<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>musescript</groupId>
  <artifactId>muse-graal-stress</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Keep in lockstep with the installed GraalVM (graalvm-community-25.1.3). -->
    <graalwasm.version>25.1.3</graalwasm.version>
    <!-- KestrGraal (persistent-process gRPC server, muse-lab plan Phase 1 addendum). -->
    <grpc.version>1.82.1</grpc.version>
    <protobuf.version>3.25.8</protobuf.version>
    <!-- Default entry point for `mvn exec:java` (run.ps1 graal). Override on the command line
         with -Dexec.mainClass=musescript.graal.KestrGraalServer to run the server instead — a
         literal <mainClass> value below would NOT be overridable this way; it must stay a
         property reference for -Dexec.mainClass to take effect. -->
    <exec.mainClass>musescript.graal.MuseGraalStress</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>polyglot</artifactId>
      <version>${graalwasm.version}</version>
    </dependency>
    <!-- Pulls in GraalWasm + the optimizing Truffle runtime. -->
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>wasm-community</artifactId>
      <version>${graalwasm.version}</version>
      <type>pom</type>
    </dependency>
    <!-- Jenetics 8.3.0 — Java 21; used alongside the Haxe evo adapter on JVM. -->
    <dependency>
      <groupId>io.jenetics</groupId>
      <artifactId>jenetics</artifactId>
      <version>8.3.0</version>
    </dependency>

    <!-- KestrGraalServer — bound-process gRPC front for the shared-Engine WASM harness. -->
    <!-- compile-scoped (not runtime): KestrGraalServer imports the shaded NettyServerBuilder
         directly to pin the listen socket to loopback (see class javadoc). -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- Resolves the OS-classified protoc / protoc-gen-grpc-java binaries below. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <!-- Property reference (not a literal) so -Dexec.mainClass=... on the command line can
               actually override it. Default is set in <properties> above. -->
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
